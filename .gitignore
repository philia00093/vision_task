# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 模型权重 ----
# yolo26n.pt 随仓库提供（开箱即用）。其余权重（更大主干、自训练大模型）不入库：
#   python vision_yolo_train/tools/download_weights.py --models yolo26s.pt
vision_yolo_train/weights/*.pt
!vision_yolo_train/weights/yolo26n.pt
*.onnx

# ---- 数据集：图片/标签多为现场私有素材，不入库 ----
vision_yolo_train/datasets/*/images/*/
vision_yolo_train/datasets/*/labels/*/
vision_yolo_train/datasets/annotate/
vision_yolo_train/raw_frames/
vision_yolo_train/annotations/

# ---- 待标注图片：默认跟踪（标注与训练要用），如需忽略请注释下面两行 ----
# vision_yolo_train/images/

# ---- 训练输出与运行产物 ----
vision_yolo_train/runs/
output/
*.mp4
*.avi
*.json

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
desktop.ini
